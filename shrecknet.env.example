# One public website origin shared by browser-auth origin validation and cookie
# security mode. Local Compose defaults to http://localhost; for deployment use
# your HTTPS domain, for example https://shrecknet.club.
SHRECKNET_PUBLIC_ORIGIN=http://localhost

# Browser login is enabled by the root Compose stack. Persistent Fernet and JWT
# signing keys are generated automatically and stored under shrecknet/databases.
