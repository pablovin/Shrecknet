<div class="shrecknet-shell shrecknet-connection-settings">
  <header class="shrecknet-header"><strong>SHRECKNET CONNECTION</strong></header>
  {{#if notice}}<p class="shrecknet-notice">{{notice}}</p>{{/if}}

  {{#if configured}}
    <section class="shrecknet-form">
      <h2>Connection active</h2>
      <dl class="shrecknet-connection-status">
        <dt>Server</dt><dd>{{connection.serverUrl}}</dd>
        <dt>Shrecknet World</dt><dd>{{connection.worldName}}</dd>
        <dt>Status</dt><dd class="status-{{connection.status}}">{{connection.status}}</dd>
        {{#if connection.checkedAt}}<dt>Last checked</dt><dd>{{connection.checkedAt}}</dd>{{/if}}
      </dl>
      <button type="button" data-action="checkConnection">Check connection now</button>
      <form class="shrecknet-form shrecknet-service-settings" data-shrecknet-submit="saveServiceUrls">
        <h3>Connected services</h3>
        <label>ShreckWorld API URL <input name="shreckWorldUrl" type="url" value="{{shreckWorldUrl}}" required></label>
        <label>ShreckRPG API URL <input name="shreckRpgUrl" type="url" value="{{shreckRpgUrl}}" required></label>
        <button type="submit">Save service URLs</button>
      </form>
      <p class="shrecknet-help">The browser connects directly to these APIs. Configure CORS to allow the Foundry origin. The service key was used only during setup and is not stored in Foundry.</p>
    </section>
  {{else if hasWorldChoices}}
    <form class="shrecknet-form">
      <h2>Choose Shrecknet World</h2>
      <p class="shrecknet-help">The connection is verified. Select the World this Foundry World will browse, then enable it.</p>
      <input name="serverUrl" type="hidden" value="{{connection.serverUrl}}">
      <label>Shrecknet World
        <select name="worldId" required>
          <option value="">Select a World</option>
          {{#each worldChoices}}<option value="{{id}}">{{name}}</option>{{/each}}
        </select>
      </label>
      <label>ShreckWorld API URL
        <input name="shreckWorldUrl" type="url" value="{{shreckWorldUrl}}" placeholder="https://example.com/shreckworld-api" required>
      </label>
      <label>ShreckRPG API URL
        <input name="shreckRpgUrl" type="url" value="{{shreckRpgUrl}}" placeholder="https://example.com/api/shreckrpg" required>
      </label>
      <button type="button" data-action="saveConnection">Enable connection</button>
      <p class="shrecknet-help">Use browser-reachable HTTPS API base URLs. Each API must allow requests from this Foundry origin.</p>
    </form>
  {{else}}
    <form class="shrecknet-form">
      <h2>Initial setup</h2>
      <p class="shrecknet-help">This is the only place a service key can be entered. It is discarded after the connection is saved.</p>
      <label>Server URL <input name="serverUrl" type="url" value="{{connection.serverUrl}}" required></label>
      <label>Service Key <input name="integrationKey" type="password" autocomplete="off" required></label>
      <button type="button" data-action="testConnection">Test connection</button>
      {{#if connectionTested}}<p class="shrecknet-help">No Worlds were returned for this service key. Update its allowed World IDs in Shrecknet and test again.</p>{{/if}}
    </form>
  {{/if}}
</div>
