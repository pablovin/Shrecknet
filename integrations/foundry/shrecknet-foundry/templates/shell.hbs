<div class="shrecknet-shell">
  <header class="shrecknet-header">
    <button type="button" class="shrecknet-brand" data-action="openHome" aria-label="Shrecknet Atlas home">
      <img src="modules/shrecknet-foundry/assets/shrecknet-logo.svg" alt="">
      <span><strong>Shrecknet</strong><small>{{connection.worldName}}</small></span>
    </button>
    {{#if authenticated}}
      <div class="shrecknet-account">
        <span class="shrecknet-connection-indicator status-{{connection.status}}" aria-hidden="true"></span>
        <span class="shrecknet-visually-hidden">Connection {{connection.status}}</span>
        <span>{{user.username}}</span>
        <button type="button" data-action="signOut">Sign out</button>
      </div>
    {{/if}}
  </header>

  {{#if notice}}<p class="shrecknet-notice">{{notice}}</p>{{/if}}
  {{#if isLoading}}<div class="shrecknet-loading" role="status" aria-live="polite"><span class="shrecknet-loading-spinner" aria-hidden="true"></span>Loading Shrecknet content…</div>{{/if}}

  {{#unless configured}}
    <section class="shrecknet-connect-prompt">
      <h2>Connect this table</h2>
      <p>This Foundry World has not been connected to Shrecknet. A GM must configure it in <strong>Game Settings → Configure Settings → Shrecknet Connection</strong>.</p>
    </section>
  {{else if (not authenticated)}}
    <form class="shrecknet-form">
      <h2>Connected World: {{connection.worldName}}</h2>
      <label>Email or Username <input name="identifier" autocomplete="username" required></label>
      <label>Password <input name="password" type="password" autocomplete="current-password" required></label>
      <button type="button" data-action="signIn">Sign In</button>
    </form>
  {{else}}
    <div class="shrecknet-workspace">
      <aside class="shrecknet-sidebar" aria-label="Shrecknet workspace">
        <p class="shrecknet-sidebar-label">WORKSPACE</p>
        <button type="button" class="shrecknet-sidebar-link {{#if isAtlasWorkspace}}is-active{{/if}}" data-action="openHome" {{#if isAtlasWorkspace}}aria-current="page"{{/if}}>
          <span class="fa-solid fa-compass" aria-hidden="true"></span><span>Atlas</span>
        </button>
        <button type="button" class="shrecknet-sidebar-link {{#if isSceneWorkspace}}is-active{{/if}}" data-action="openSceneCollection" {{#if isSceneWorkspace}}aria-current="page"{{/if}}>
          <span class="fa-solid fa-film" aria-hidden="true"></span><span>Narrative Scenes</span>
        </button>
        <button type="button" class="shrecknet-sidebar-link {{#if isElderWorkspace}}is-active{{/if}}" data-action="openElder" {{#if isElderWorkspace}}aria-current="page"{{/if}}>
          <span class="fa-solid fa-user-secret" aria-hidden="true"></span><span>Elder</span>
        </button>
        <button type="button" class="shrecknet-sidebar-link {{#if isKnowledgeWorkspace}}is-active{{/if}}" data-action="openKnowledgeWorlds" {{#if isKnowledgeWorkspace}}aria-current="page"{{/if}}>
          <span class="fa-solid fa-book" aria-hidden="true"></span><span>ShreckWorld</span>
        </button>
        <button type="button" class="shrecknet-sidebar-link {{#if isChroniclesWorkspace}}is-active{{/if}}" data-action="openChronicles" {{#if isChroniclesWorkspace}}aria-current="page"{{/if}}>
          <span class="fa-solid fa-scroll" aria-hidden="true"></span><span>Chronicles</span>
        </button>
      </aside>
      <main class="shrecknet-main">
        <nav class="shrecknet-toolbar" aria-label="Navigation and search">
          <div class="shrecknet-history">
            <button type="button" data-action="goBack" aria-label="Go back" title="Go back" {{#unless canGoBack}}disabled{{/unless}}>←</button>
            <button type="button" data-action="goForward" aria-label="Go forward" title="Go forward" {{#unless canGoForward}}disabled{{/unless}}>→</button>
          </div>
          {{#if isAtlasWorkspace}}<form data-shrecknet-submit="search" role="search">
            <label class="shrecknet-visually-hidden" for="shrecknet-atlas-search">Search Atlas and narrative scenes</label>
            <input id="shrecknet-atlas-search" name="query" placeholder="Search {{connection.worldName}}…" required>
            <button type="button" data-action="search" aria-label="Search">Search</button>
          </form>{{else if isSceneWorkspace}}<form data-shrecknet-submit="searchScenes" role="search">
            <label class="shrecknet-visually-hidden" for="shrecknet-global-scene-search">Search narrative scenes</label>
            <input id="shrecknet-global-scene-search" name="sceneQuery" placeholder="Search narrative scenes…">
            <button type="button" data-action="searchScenes" aria-label="Search scenes">Search</button>
          </form>{{/if}}
        </nav>
        <div class="shrecknet-content {{#if isElderWorkspace}}is-elder-content{{/if}} {{#if knowledge}}is-knowledge-content{{/if}}">
          <p class="shrecknet-notice" data-workspace-notice hidden role="status"></p>
          {{#if resource.breadcrumbs}}<nav class="shrecknet-breadcrumbs" aria-label="Breadcrumb">{{#each resource.breadcrumbs}}{{#if action}}<button type="button" data-action="{{action}}" data-ontology-id="{{ontologyId}}" data-definition-id="{{definitionId}}" data-world-id="{{worldId}}" data-title="{{label}}">{{label}}</button>{{else}}<span>{{label}}</span>{{/if}}{{#unless @last}}<span aria-hidden="true"> &gt; </span>{{/unless}}{{/each}}</nav>{{/if}}

          {{#if (eq resource.kind "home")}}
            <h2>Welcome to {{resource.title}}</h2>
            <p class="shrecknet-intro">Explore the connected universe and its narrative scenes.</p>
            <div class="shrecknet-grid">
              {{#each resource.folders}}<button type="button" class="shrecknet-folder" data-action="openFolder" data-ontology-id="{{ontologyId}}" data-definition-id="{{id}}" data-title="{{name}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-folder-placeholder" aria-hidden="true"><span class="fa-solid fa-book-open"></span></span>{{/if}}<strong>{{name}}</strong><small>{{ontologyName}}</small></button>{{/each}}
            </div>
          {{else if (eq resource.kind "folder")}}
            <h2>{{resource.title}}</h2>
            {{#if resource.pages.length}}<div class="shrecknet-card-grid">{{#each resource.pages}}<button type="button" class="shrecknet-page-card" data-action="openInstance" data-instance-id="{{instance_id}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-file-lines"></span></span>{{/if}}<span>{{displayName}}</span></button>{{/each}}</div>{{else}}<p class="shrecknet-empty">No pages found.</p>{{/if}}
          {{else if (eq resource.kind "instance")}}
            <section class="shrecknet-atlas-explorer {{#if readerFocus}}is-reading-focused{{/if}}">
              <header class="shrecknet-atlas-header">
                {{#if resource.instance.pageImageUrl}}<img src="{{resource.instance.pageImageUrl}}" alt="">{{/if}}
                <div><p class="shrecknet-kicker">ATLAS EXPLORER</p><h2>{{resource.instance.displayName}}</h2><p>{{resource.instance.typeNames}}</p></div>
                <div class="shrecknet-atlas-actions"><button type="button" data-action="showOnChat">Show in chat</button><button type="button" data-action="toggleReaderFocus" aria-pressed="{{readerFocus}}">{{#if readerFocus}}Show panels{{else}}Focus reading{{/if}}</button></div>
              </header>
              <div class="shrecknet-atlas-columns">
                <details class="shrecknet-atlas-navigation" data-explorer-panel="navigation">
                  <summary>Relationships and scenes</summary>
                  <div class="shrecknet-atlas-panel-content">
                    <h3>Relationships</h3>
                    {{#each resource.instance.relationshipGroups}}<details class="shrecknet-relationship-group" open><summary>{{name}}</summary><ul>{{#each targets}}<li>{{#if unavailable}}<span class="shrecknet-unavailable-related">Related page unavailable</span>{{else}}<button type="button" data-action="openInstance" data-instance-id="{{instanceId}}"><strong>{{name}}</strong><small>{{typeName}}</small></button>{{/if}}</li>{{/each}}</ul></details>{{else}}<p class="shrecknet-empty">No relationships.</p>{{/each}}
                    {{#if resource.instance.scenes.length}}<details open><summary>Narrative scenes · {{resource.instance.scenes.length}}</summary><ol class="shrecknet-atlas-scenes">{{#each resource.instance.scenes}}<li><button type="button" data-action="openScene" data-instance-id="{{../resource.instance.instance_id}}" data-scene-id="{{id}}">{{name}}</button></li>{{/each}}</ol></details>{{/if}}
                    {{#if resource.instance.related_content.length}}<details><summary>Related content</summary><ul>{{#each resource.instance.related_content}}<li><button type="button" data-action="openInstance" data-instance-id="{{id}}">{{displayName}}</button></li>{{/each}}</ul></details>{{/if}}
                  </div>
                </details>
                <main class="shrecknet-atlas-reading" aria-label="Page text">
                  {{#each resource.instance.entities}}
                    <article class="shrecknet-record"><h3>{{alias}}</h3>
                      {{#if showAvatar}}<img class="shrecknet-section-avatar" src="{{avatarUrl}}" alt="">{{/if}}
                      {{#if hasBothTextSources}}<div class="shrecknet-tabs" role="group" aria-label="Text source"><button type="button" class="{{#if showText}}is-active{{/if}}" aria-pressed="{{showText}}" data-action="selectTextSource" data-entity-id="{{entity_instance_id}}" data-source="text">Original text</button><button type="button" class="{{#if showGeneratedText}}is-active{{/if}}" aria-pressed="{{showGeneratedText}}" data-action="selectTextSource" data-entity-id="{{entity_instance_id}}" data-source="generated">Generated text</button></div>{{/if}}
                      {{#if showText}}<p class="shrecknet-source-label">Original text</p><div class="shrecknet-document-text">{{{textHtml}}}</div>{{/if}}
                      {{#if showGeneratedText}}<p class="shrecknet-source-label">Generated text</p><div class="shrecknet-document-text">{{{generatedTextHtml}}}</div>{{/if}}
                      {{#unless hasText}}{{#unless hasGeneratedText}}<p class="shrecknet-empty">No document text available.</p>{{/unless}}{{/unless}}
                    </article>
                  {{else}}<p class="shrecknet-empty">No document text available.</p>{{/each}}
                </main>
                <details class="shrecknet-atlas-context" data-explorer-panel="context">
                  <summary>Properties</summary><div class="shrecknet-atlas-panel-content">
                  {{#each resource.instance.entities}}<section><h3>{{alias}}</h3>{{#if properties.length}}<dl class="shrecknet-properties">{{#each properties}}<div><dt>{{displayName}}</dt><dd>{{displayValue}}</dd></div>{{/each}}</dl>{{else}}<p class="shrecknet-empty">No properties.</p>{{/if}}</section>{{/each}}
                  </div>
                </details>
              </div>
            </section>
          {{else if (eq resource.kind "sceneCollection")}}
            <section class="shrecknet-scene-collection"><header><p>NARRATIVE SCENES</p><h2>{{resource.title}}</h2><form data-shrecknet-submit="searchScenes" role="search"><label class="shrecknet-visually-hidden" for="shrecknet-scene-search">Search scene names</label><input id="shrecknet-scene-search" name="sceneQuery" value="{{resource.query}}" placeholder="Search scene names…"><button type="button" data-action="searchScenes">Search scenes</button></form></header>
            {{#if resource.groups.length}}{{#each resource.groups}}<details class="shrecknet-scene-group"><summary>{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{/if}}<span>{{name}}</span><small>{{scenes.length}} scenes</small></summary><div class="shrecknet-scene-group-content"><button type="button" class="shrecknet-source-page" data-action="openInstance" data-instance-id="{{instanceId}}">Open source page</button><div class="shrecknet-scene-rows">{{#each scenes}}<button type="button" class="shrecknet-scene-row" data-action="openScene" data-instance-id="{{instance_id}}" data-scene-id="{{id}}"><strong>{{name}}</strong><small>{{milestone_count}} milestones · {{perspective_count}} perspectives</small></button>{{/each}}</div></div></details>{{/each}}{{else}}<p class="shrecknet-empty">No scenes found.</p>{{/if}}</section>
          {{else if (eq resource.kind "scene")}}
            <article class="shrecknet-scene-dossier">
              <header><p>NARRATIVE SCENE</p><h2>{{resource.scene.name}}</h2><small>{{resource.scene.milestones.length}} milestones</small></header>
              <section class="shrecknet-shortcuts"><h3>Source</h3><div class="shrecknet-card-grid shrecknet-related-grid"><button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{resource.sourcePageCard.instance_id}}">{{#if resource.sourcePageCard.imageUrl}}<img src="{{resource.sourcePageCard.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-file-lines"></span></span>{{/if}}<span>{{resource.sourcePageCard.displayName}}</span></button></div></section>
              <div class="shrecknet-document-text">{{resource.scene.description}}</div>
              {{#if resource.scene.previousScene}}<section class="shrecknet-scene-links"><h3>Previous scene</h3><button type="button" class="shrecknet-page-scene-row" data-action="openScene" data-instance-id="{{resource.scene.instance_id}}" data-scene-id="{{resource.scene.previousScene.id}}">← {{resource.scene.previousScene.name}}</button></section>{{/if}}
              {{#if resource.scene.nextScene}}<section class="shrecknet-scene-links"><h3>Next scene</h3><button type="button" class="shrecknet-page-scene-row" data-action="openScene" data-instance-id="{{resource.scene.instance_id}}" data-scene-id="{{resource.scene.nextScene.id}}">{{resource.scene.nextScene.name}} →</button></section>{{/if}}
              {{#if resource.scene.relates_to.length}}<section class="shrecknet-shortcuts"><h3>Related records</h3><div class="shrecknet-card-grid shrecknet-related-grid">{{#each resource.scene.relates_to}}{{#if card}}<button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{card.instanceId}}">{{#if card.imageUrl}}<img src="{{card.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-file-lines"></span></span>{{/if}}<span>{{label}} · {{card.name}}</span></button>{{else}}<span class="shrecknet-unavailable-related">{{label}} · related record unavailable</span>{{/if}}{{/each}}</div></section>{{/if}}
              {{#if resource.scene.milestones.length}}<section class="shrecknet-timeline"><h3>Milestone timeline</h3>{{#each resource.scene.milestones}}<article><span class="shrecknet-timeline-marker" aria-hidden="true">●</span><h4>{{name}}</h4><div>{{description}}</div>{{#if relates_to.length}}<div class="shrecknet-card-grid shrecknet-related-grid">{{#each relates_to}}{{#if card}}<button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{card.instanceId}}">{{#if card.imageUrl}}<img src="{{card.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-file-lines"></span></span>{{/if}}<span>{{label}} · {{card.name}}</span></button>{{else}}<span class="shrecknet-unavailable-related">{{label}} · related record unavailable</span>{{/if}}{{/each}}</div>{{/if}}</article>{{/each}}</section>{{/if}}
              <section class="shrecknet-perspectives"><h3>Character perspectives</h3><p>0 available</p></section>
            </article>
          {{else if (eq resource.kind "search")}}
            <h2>{{resource.title}}</h2>
            <section class="shrecknet-search-section"><h3>Pages</h3>{{#if resource.instances.length}}<div class="shrecknet-card-grid">{{#each resource.instances}}<button type="button" class="shrecknet-page-card" data-action="openInstance" data-instance-id="{{instance_id}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-file-lines"></span></span>{{/if}}<span>{{displayName}}</span></button>{{/each}}</div>{{else}}<p class="shrecknet-empty">No page results.</p>{{/if}}</section>
            <section class="shrecknet-search-section"><h3>Narrative Scenes</h3>{{#if resource.sceneGroups.length}}{{#each resource.sceneGroups}}<details class="shrecknet-scene-group"><summary>{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{/if}}<span>{{name}}</span><small>{{scenes.length}} scene hits</small></summary><div class="shrecknet-scene-group-content"><button type="button" class="shrecknet-source-page" data-action="openInstance" data-instance-id="{{instanceId}}">Open source page</button><div class="shrecknet-scene-rows">{{#each scenes}}<button type="button" class="shrecknet-scene-row" data-action="openScene" data-instance-id="{{instance_id}}" data-scene-id="{{id}}"><strong>{{name}}</strong><small>{{milestone_count}} milestones · {{perspective_count}} perspectives</small></button>{{/each}}</div></div></details>{{/each}}{{else}}<p class="shrecknet-empty">No narrative scene results.</p>{{/if}}</section>
          {{else if (eq resource.kind "knowledgeWorlds")}}
            <section class="shrecknet-service-page">
              <p class="shrecknet-kicker">SHRECKWORLD</p><h2>Knowledge worlds</h2>
              <p class="shrecknet-intro">Choose a library to consult your books with grounded answers and source excerpts.</p>
              {{#if resource.worlds.length}}<div class="shrecknet-card-grid">{{#each resource.worlds}}
                <button type="button" class="shrecknet-page-card" data-action="openKnowledgeWorld" data-world-id="{{id}}">
                  <span class="shrecknet-card-placeholder" aria-hidden="true"><span class="fa-solid fa-book"></span></span>
                  <span>{{name}}</span>
                </button>
              {{/each}}</div>{{else}}<p class="shrecknet-empty">No ShreckWorlds are available to this account.</p>{{/if}}
            </section>
          {{else if knowledge}}
            <section class="shrecknet-knowledge {{#if knowledge.showBooks}}show-books{{else}}show-companion{{/if}}" aria-label="ShreckWorld library and rules companion">
              <header class="shrecknet-knowledge-heading"><div><h2>ShreckWorld</h2><p>{{resource.world.name}} · Your library and rules companion</p></div><button type="button" class="shrecknet-knowledge-toggle" data-action="toggleKnowledgePane">{{#if knowledge.showBooks}}Show Companion{{else}}Show Books{{/if}}</button></header>
              <div class="shrecknet-knowledge-columns">
                <aside class="shrecknet-bookshelf" aria-label="Your Books">
                  <h3>Your Books</h3><label><span class="shrecknet-visually-hidden">Search your library</span><input type="search" data-knowledge-search placeholder="Search your library…"></label>
                  <div class="shrecknet-book-list">{{#each knowledge.books}}<article class="shrecknet-book {{#if selected}}is-selected{{/if}}" data-book-title="{{title}}">
                    <a href="{{readerUrl}}" target="_blank" rel="noopener noreferrer" aria-label="Open {{title}} in Shrecknet">{{#if coverUrl}}<img src="{{coverUrl}}" alt="">{{else}}<span class="shrecknet-book-cover" aria-hidden="true">♧</span>{{/if}}</a>
                    <div><a href="{{readerUrl}}" target="_blank" rel="noopener noreferrer"><strong>{{title}} ↗</strong></a><small>{{authors}}</small><small>{{authority_tier}}</small><small>{{readiness}}</small><label><input type="checkbox" data-knowledge-source value="{{id}}" {{#if selected}}checked{{/if}} {{#if ../knowledge.busy}}disabled{{/if}}>Use for questions</label></div>
                  </article>{{else}}<p class="shrecknet-empty">No books in this library.</p>{{/each}}</div>
                  <a class="shrecknet-manage-library" href="{{knowledge.manageUrl}}" target="_blank" rel="noopener noreferrer">Manage library ↗</a>
                </aside>
                <section class="shrecknet-rules-companion" aria-label="Shreck Companion">
                  <header><span class="shrecknet-elder-emblem" aria-hidden="true">✧</span><div><h3>Shreck Companion</h3><small>Your books, explained</small></div></header>
                  <div class="shrecknet-book-context"><strong>Searching: {{knowledge.scope}}</strong><small>Select books on the shelf. With none selected, all books are searched.</small></div>
                  <div class="shrecknet-knowledge-log" role="log" aria-label="Rules conversation" aria-live="polite" aria-busy="{{knowledge.busy}}">
                    {{#each knowledge.turns}}<div class="shrecknet-rules-turn"><p class="shrecknet-rules-question">{{query}}</p><article><strong>✧ Shreck Companion</strong><p class="shrecknet-rules-answer">{{answer}}</p><small>Answer status: {{status}}</small>
                      {{#each warnings}}<p class="shrecknet-notice">{{message}}</p>{{/each}}
                      {{#each conflicts}}<p class="shrecknet-notice"><strong>Source conflict</strong> {{description}} · {{citation_ids}}</p>{{/each}}
                      {{#each missing}}<p class="shrecknet-notice">{{this}}</p>{{/each}}
                      {{#each citations}}<details class="shrecknet-rule-citation"><summary>{{source_id}} · {{title}}{{#if page_number}} · Page {{page_number}}{{/if}}</summary><p>{{authority_tier}} {{#if page_label}}· Printed page {{page_label}}{{/if}}</p><blockquote>{{excerpt}}</blockquote>{{#if parent_excerpt}}<details><summary>More context</summary><p>{{parent_excerpt}}</p></details>{{/if}}{{#if readerUrl}}<a href="{{readerUrl}}" target="_blank" rel="noopener noreferrer">Open source in Shrecknet ↗</a>{{/if}}</details>{{/each}}
                      <div class="shrecknet-answer-actions"><button type="button" data-action="copyKnowledgeAnswer" data-turn="{{index}}">Copy answer</button><button type="button" data-action="shareKnowledgeAnswer" data-turn="{{index}}">Send to Foundry chat</button></div>
                    </article></div>{{else}}<div class="shrecknet-elder-welcome"><span aria-hidden="true">✧</span><h3>What do your books say?</h3><p>Ask a rules question to find an explanation and its supporting passages.</p></div>{{/each}}
                    {{#if knowledge.busy}}<p role="status">Consulting your books…</p>{{/if}}
                  </div>
                  <form class="shrecknet-elder-composer" data-shrecknet-submit="queryKnowledge"><label class="shrecknet-visually-hidden" for="shrecknet-rules-query">Ask about your books</label><textarea id="shrecknet-rules-query" data-knowledge-draft name="query" rows="2" maxlength="4000" required placeholder="Ask anything about your books…" {{#if knowledge.busy}}disabled{{/if}}>{{knowledge.draft}}</textarea><div><small>♧ Book context · Each question searches the selected books</small><button type="submit" aria-label="Send rules question" {{#if knowledge.busy}}disabled{{/if}}>↑</button></div></form>
                </section>
              </div>
            </section>
          {{else if (eq resource.kind "elder")}}
            <section class="shrecknet-elder-page" aria-label="Elder Companion">
              {{#if elderAgents.length}}
                <header class="shrecknet-elder-identity">
                  {{#if elderIdentity.avatarUrl}}<img src="{{elderIdentity.avatarUrl}}" alt="">{{else}}<span class="shrecknet-elder-emblem" aria-hidden="true">✧</span>{{/if}}
                  <div><h2>{{elderIdentity.name}}</h2><p>{{#if elderIdentity.description}}{{elderIdentity.description}}{{else}}Elder of {{connection.worldName}}{{/if}}</p><small>Atlas companion</small></div>
                  <label><span class="shrecknet-visually-hidden">Switch Elder</span><select data-elder-select {{#if isAskingElder}}disabled{{/if}}>{{#each elderAgents}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
                </header>
                <aside class="shrecknet-elder-context" aria-label="Active context"><strong>Active context</strong><div><span>{{connection.worldName}}</span>{{#if elderContext}}<button type="button" data-action="openInstance" data-instance-id="{{elderContext.id}}">{{elderContext.name}}</button><button type="button" data-action="clearElderContext" {{#if isAskingElder}}disabled{{/if}}>Clear page focus</button>{{else}}<span>Whole Atlas</span>{{/if}}</div><small>Page focus guides the answer; the Elder may also retrieve other Atlas evidence.</small></aside>
                <div class="shrecknet-elder-history" role="log" aria-label="Conversation" aria-live="polite" aria-busy="{{isAskingElder}}">
                  {{#each elderHistory}}
                    <article class="shrecknet-elder-message {{#if isUser}}role-user{{else}}role-assistant{{/if}}"><strong>{{#if isUser}}You{{else}}{{../elderIdentity.name}}{{/if}}</strong><div>{{content}}</div>
                      {{#if citations.length}}<details class="shrecknet-elder-sources"><summary>{{citations.length}} sources</summary>{{#each citations}}<article><h3>{{title}}</h3>{{#if excerpts.length}}{{#each excerpts}}<blockquote>{{this}}</blockquote>{{/each}}{{else}}{{#if text}}<blockquote>{{text}}</blockquote>{{else}}<p>No excerpt returned.</p>{{/if}}{{/if}}{{#if instanceId}}<button type="button" data-action="openInstance" data-instance-id="{{instanceId}}">Open Atlas page</button>{{/if}}</article>{{/each}}</details>{{/if}}
                    </article>
                  {{else}}<div class="shrecknet-elder-welcome"><span aria-hidden="true">✧</span><h3>Consult {{elderIdentity.name}}</h3><p>Ask about the people, places, and events of {{connection.worldName}}.</p></div>{{/each}}
                  {{#if isAskingElder}}<p role="status">{{elderIdentity.name}} is consulting the Atlas…</p>{{/if}}
                </div>
                <form class="shrecknet-elder-composer" data-shrecknet-submit="askElder">
                  <label class="shrecknet-visually-hidden" for="shrecknet-elder-query">Ask {{elderIdentity.name}}</label><textarea id="shrecknet-elder-query" data-elder-draft name="query" rows="2" maxlength="4000" required placeholder="Ask {{elderIdentity.name}} about this world…" {{#if isAskingElder}}disabled{{/if}}>{{elderDraft}}</textarea>
                  <div><small>✧ Atlas context</small><button type="submit" aria-label="Send question" {{#if isAskingElder}}disabled{{/if}}>↑</button></div>
                </form>
              {{else}}<p class="shrecknet-empty">No Elders are configured for the connected Atlas ontologies.</p>{{/if}}
            </section>
          {{else if (eq resource.kind "chronicleLibrary")}}
            <section class="shrecknet-service-page">
              <p class="shrecknet-kicker">SHRECKRPG</p><h2>Chronicles</h2>
              <form class="shrecknet-query-form shrecknet-create-chronicle" data-shrecknet-submit="createChronicle">
                <label>New Chronicle title<input name="title" maxlength="255" required placeholder="A chronicle for this table"></label>
                <button type="submit">Create Chronicle</button>
              </form>
              {{#if resource.chronicles.length}}<div class="shrecknet-source-list">{{#each resource.chronicles}}
                <button type="button" class="shrecknet-source-card" data-action="openChronicle" data-chronicle-id="{{id}}">
                  <strong>{{title}}</strong><span>Revision {{revision}}</span><small>Updated {{updated_at}} · {{#if shared_with.length}}Shared{{else}}Private{{/if}}</small>
                </button>
              {{/each}}</div>{{else}}<p class="shrecknet-empty">No Chronicles yet. Create one to begin.</p>{{/if}}
            </section>
          {{else if (eq resource.kind "chronicle")}}
            <article class="shrecknet-service-page shrecknet-chronicle">
              <header class="shrecknet-chronicle-header"><p class="shrecknet-kicker">CHRONICLE · REVISION {{resource.chronicle.revision}}</p><h2>{{resource.chronicle.title}}</h2></header>
              <div class="shrecknet-chronicle-actions">
                {{#if canShowChronicleImages}}<button type="button" data-action="showChronicleOnChat">Show on chat</button>{{/if}}
                {{#if canDeleteChronicle}}<button type="button" data-action="deleteChronicle">Delete</button>{{/if}}
                <button type="button" data-action="reloadChronicle">Reload</button>
              </div>
              <form data-shrecknet-submit="saveChronicle">
                <label>Title<input name="title" maxlength="255" value="{{resource.chronicle.title}}" {{#unless canEditChronicle}}readonly{{/unless}}></label>
                {{#if canEditChronicle}}
                  <div class="shrecknet-chronicle-editor" data-chronicle-editor contenteditable="true" role="textbox" aria-label="Chronicle document" aria-multiline="true">{{{resource.contentHtml}}}</div>
                  <label class="shrecknet-upload-label">Add image<input type="file" data-chronicle-upload accept="image/jpeg,image/png,image/gif,image/webp"></label>
                  {{#if canShareChronicle}}<fieldset class="shrecknet-sharing"><legend>Share with players</legend>{{#each chronicleRecipients}}<label><input type="checkbox" name="recipientIds" value="{{id}}" {{#if selected}}checked{{/if}}> {{full_name}} ({{username}})</label>{{/each}}</fieldset>{{/if}}
                  <div class="shrecknet-chronicle-images" data-chronicle-images>{{#if canShowChronicleImages}}{{#each resource.images}}<button type="button" data-action="showChronicleImage" data-asset-url="{{sourceUrl}}" data-title="{{title}}">Show {{title}} to players</button>{{/each}}{{/if}}</div>
                  <button type="submit">Save Chronicle</button>
                {{else}}
                  <div class="shrecknet-chronicle-document">{{{resource.contentHtml}}}</div>
                  {{#if canShowChronicleImages}}<div class="shrecknet-chronicle-images">{{#each resource.images}}<button type="button" data-action="showChronicleImage" data-asset-url="{{sourceUrl}}" data-title="{{title}}">Show {{title}} to players</button>{{/each}}</div>{{/if}}
                {{/if}}
              </form>
            </article>
          {{/if}}
        </div>
      </main>
    </div>
  {{/unless}}
</div>
