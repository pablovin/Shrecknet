# Shrecknet's own deployment settings. Copy this file to the repository-root .env.
# Keep the local default for HTTP on localhost; set the public HTTPS origin here
# for your server deployment.
SHRECKNET_PUBLIC_ORIGIN=http://localhost

# Compose PDF indexing experiment; set to docling to restore the previous parser.
SHRECKWORLD_PDF_PARSER=pymupdf


# Shared browser CORS policy. Read directly by API containers; restart to apply.
CORS_ALLOW_ORIGINS=["https://shrecknet.club","https://foundry.shrecknet.club","http://localhost","http://localhost:80","http://127.0.0.1","http://127.0.0.1:80","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8100","http://127.0.0.1:8100"]
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS","HEAD"]
# Idempotency-Key is required for Companion New chat and Send.
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Range","If-Range","X-Shrecknet-Integration-Key","Idempotency-Key"]
CORS_MAX_AGE=3600

# Service wiring is automatic: native runs use localhost (8111/8121/8200),
# Compose uses shreckllm/shreckworld_api/shreckrpg_api on the shared Docker network.
# Override only for a non-standard deployment; restart API/workers after changes.
# SHRECKNET_SHRECKLLM_BASE_URL=http://localhost:8111
# SHRECKNET_SHRECKWORLD_BASE_URL=http://localhost:8121
# SHRECKNET_SHRECKRPG_BASE_URL=http://localhost:8200
# Built-in provider web search needs no URL. Optional custom JSON search only:
# SHRECKNET_COMPANION_WEB_SEARCH_URL=https://your-search-service/search
# SHRECKNET_COMPANION_WEB_SEARCH_TOKEN=
