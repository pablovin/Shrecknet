{
  "app_name": "shrecknet",
  "debug": false,
  "cors_allow_origins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000",
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "http://localhost:8100",
    "http://127.0.0.1:8100"
  ],
  "cors_allow_origin_regex": "https://.*\\.lovableproject\\.com",
  "cors_allow_credentials": true,
  "cors_allow_methods": ["*"],
  "cors_allow_headers": ["*"],
  "cors_max_age": 3600,
