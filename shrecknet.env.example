# Shrecknet's own deployment settings. Copy this file to the repository-root .env.
# Keep the local default for HTTP on localhost; set the public HTTPS origin here
# for your server deployment.
SHRECKNET_PUBLIC_ORIGIN=http://localhost


# Shared browser CORS policy. Read directly by API containers; restart to apply.
CORS_ALLOW_ORIGINS=["https://shrecknet.club","https://foundry.shrecknet.club","http://localhost","http://localhost:80","http://127.0.0.1","http://127.0.0.1:80","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8100","http://127.0.0.1:8100"]
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS","HEAD"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Range","If-Range","X-Shrecknet-Integration-Key"]
CORS_MAX_AGE=3600
