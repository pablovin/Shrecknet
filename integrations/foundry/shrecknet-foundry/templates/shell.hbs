<div class="shrecknet-shell">
  <header class="shrecknet-header">
    <strong>SHRECKNET://{{connection.worldName}}</strong>
    {{#if authenticated}}<span>{{user.username}}</span>{{/if}}
  </header>

  {{#if notice}}<p class="shrecknet-notice">{{notice}}</p>{{/if}}
  {{#if isLoading}}<div class="shrecknet-loading" role="status" aria-live="polite"><span class="shrecknet-loading-spinner" aria-hidden="true"></span>Loading Shrecknet content…</div>{{/if}}

  {{#unless configured}}
    <p>This Foundry World has not been connected to Shrecknet. A GM must configure it in <strong>Game Settings → Configure Settings → Shrecknet Connection</strong>.</p>
  {{else if (not authenticated)}}
    <form class="shrecknet-form">
      <h2>Connected World: {{connection.worldName}}</h2>
      <label>Email or Username <input name="identifier" autocomplete="username" required></label>
      <label>Password <input name="password" type="password" autocomplete="current-password" required></label>
      <button type="button" data-action="signIn">Sign In</button>
    </form>
  {{else}}
    <nav class="shrecknet-nav">
      <button type="button" data-action="goBack" {{#unless canGoBack}}disabled{{/unless}}>←</button>
      <button type="button" data-action="goForward" {{#unless canGoForward}}disabled{{/unless}}>→</button>
      <button type="button" data-action="openHome">⌂ Home</button>
      <form data-shrecknet-submit="search"><input name="query" placeholder="Search pages and narrative scenes in {{connection.worldName}}..." required><button type="button" data-action="search">Search</button></form>
      <button type="button" data-action="signOut">Sign out</button>
    </nav>

    {{#if resource.breadcrumbs}}<nav class="shrecknet-breadcrumbs" aria-label="Breadcrumb">{{#each resource.breadcrumbs}}{{#if action}}<button type="button" data-action="{{action}}" data-ontology-id="{{ontologyId}}" data-definition-id="{{definitionId}}" data-title="{{label}}">{{label}}</button>{{else}}<span>{{label}}</span>{{/if}}{{#unless @last}}<span aria-hidden="true"> &gt; </span>{{/unless}}{{/each}}</nav>{{/if}}

    {{#if (eq resource.kind "home")}}
      <h2>Welcome to {{resource.title}}</h2>
      <div class="shrecknet-grid">
        {{#each resource.folders}}<button type="button" class="shrecknet-folder" data-action="openFolder" data-ontology-id="{{ontologyId}}" data-definition-id="{{id}}" data-title="{{name}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-folder-placeholder">📁</span>{{/if}}<strong>{{name}}</strong><small>{{ontologyName}}</small></button>{{/each}}
      </div>
      <button type="button" class="shrecknet-scenes-entry" data-action="openSceneCollection">▣ Narrative Scenes</button>
    {{else if (eq resource.kind "folder")}}
      <h2>{{resource.title}}</h2>
      {{#if resource.pages.length}}<div class="shrecknet-card-grid">{{#each resource.pages}}<button type="button" class="shrecknet-page-card" data-action="openInstance" data-instance-id="{{instance_id}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{displayName}}</span></button>{{/each}}</div>{{else}}<p class="shrecknet-empty">NO PAGES FOUND</p>{{/if}}
    {{else if (eq resource.kind "instance")}}
      <h2>{{resource.title}}</h2>
      {{#if resource.instance.pageImageUrl}}<div class="shrecknet-page-hero"><img src="{{resource.instance.pageImageUrl}}" alt="{{resource.instance.displayName}}">{{#if canShowPlayers}}<button type="button" data-action="showImageToPlayers" data-image-url="{{resource.instance.pageImageUrl}}" data-title="{{resource.instance.displayName}}">Show players</button>{{/if}}</div>{{/if}}
      {{#each resource.instance.entities}}
        <article class="shrecknet-record"><h3>{{alias}}</h3>{{#if showAvatar}}<div class="shrecknet-image-wrap"><img src="{{avatarUrl}}" alt="">{{#if ../canShowPlayers}}<button type="button" data-action="showImageToPlayers" data-image-url="{{avatarUrl}}" data-title="{{alias}}">Show players</button>{{/if}}</div>{{/if}}{{#if hasBothTextSources}}<div class="shrecknet-tabs"><button type="button" class="{{#if showText}}is-active{{/if}}" data-action="selectTextSource" data-entity-id="{{entity_instance_id}}" data-source="text">Text</button><button type="button" class="{{#if showGeneratedText}}is-active{{/if}}" data-action="selectTextSource" data-entity-id="{{entity_instance_id}}" data-source="generated">Generated text</button></div>{{/if}}{{#if hasText}}{{#if showText}}<p class="shrecknet-source-label">Text</p><button type="button" class="shrecknet-share-button" data-action="showOnChat" data-entity-id="{{entity_instance_id}}">Show on chat</button><div class="shrecknet-document-text">{{{textHtml}}}</div>{{/if}}{{/if}}{{#if hasGeneratedText}}{{#if showGeneratedText}}<p class="shrecknet-source-label">Generated text</p><button type="button" class="shrecknet-share-button" data-action="showOnChat" data-entity-id="{{entity_instance_id}}">Show on chat</button><div class="shrecknet-document-text">{{{generatedTextHtml}}}</div>{{/if}}{{/if}}{{#unless hasText}}{{#unless hasGeneratedText}}<p class="shrecknet-empty">NO DOCUMENT TEXT AVAILABLE</p>{{/unless}}{{/unless}}
          {{#if properties.length}}<h4>Properties</h4><dl class="shrecknet-properties">{{#each properties}}<div><dt>{{displayName}}</dt><dd>{{displayValue}}</dd></div>{{/each}}</dl>{{/if}}
          {{#if relationships.length}}<h4>Related</h4><div class="shrecknet-card-grid shrecknet-related-grid">{{#each relationships}}{{#if card}}<button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{card.instanceId}}">{{#if card.imageUrl}}<img src="{{card.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{card.name}}</span></button>{{else}}<span class="shrecknet-unavailable-related">Related record unavailable</span>{{/if}}{{/each}}</div>{{/if}}
        </article>
      {{/each}}
      {{#if resource.instance.related_content.length}}<h3>Related Content</h3><div class="shrecknet-card-grid">{{#each resource.instance.related_content}}<button type="button" class="shrecknet-page-card" data-action="openInstance" data-instance-id="{{id}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{displayName}}</span></button>{{/each}}</div>{{/if}}
      {{#if resource.instance.scenes.length}}<h3>Narrative Scenes</h3><div class="shrecknet-page-scene-list">{{#each resource.instance.scenes}}<button type="button" class="shrecknet-page-scene-row" data-action="openScene" data-instance-id="{{../resource.instance.instance_id}}" data-scene-id="{{id}}"><strong>▣ {{name}}</strong><small>Open narrative scene</small></button>{{/each}}</div>{{/if}}
    {{else if (eq resource.kind "sceneCollection")}}
      <section class="shrecknet-scene-collection"><header><p>NARRATIVE SCENES</p><h2>{{resource.title}}</h2><form data-shrecknet-submit="searchScenes"><input name="sceneQuery" value="{{resource.query}}" placeholder="Search scene names…"><button type="button" data-action="searchScenes">Search scenes</button></form></header>
      {{#if resource.groups.length}}{{#each resource.groups}}<details class="shrecknet-scene-group"><summary>{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{/if}}<span>📖 {{name}}</span><small>{{scenes.length}} scenes</small></summary><div class="shrecknet-scene-group-content"><button type="button" class="shrecknet-source-page" data-action="openInstance" data-instance-id="{{instanceId}}">Open source page</button><div class="shrecknet-scene-rows">{{#each scenes}}<button type="button" class="shrecknet-scene-row" data-action="openScene" data-instance-id="{{instance_id}}" data-scene-id="{{id}}"><strong>▣ {{name}}</strong><small>◉ {{milestone_count}} milestones · 👁 {{perspective_count}} perspectives</small></button>{{/each}}</div></div></details>{{/each}}{{else}}<p class="shrecknet-empty">NO SCENES FOUND</p>{{/if}}</section>
    {{else if (eq resource.kind "scene")}}
      <article class="shrecknet-scene-dossier">
        <header><p>NARRATIVE SCENE</p><h2>{{resource.scene.name}}</h2><small>◉ {{resource.scene.milestones.length}} milestones</small></header>
        <section class="shrecknet-shortcuts"><h3>Source</h3><div class="shrecknet-card-grid shrecknet-related-grid"><button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{resource.sourcePageCard.instance_id}}">{{#if resource.sourcePageCard.imageUrl}}<img src="{{resource.sourcePageCard.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{resource.sourcePageCard.displayName}}</span></button></div></section>
        <div class="shrecknet-document-text">{{resource.scene.description}}</div>
        {{#if resource.scene.previousScene}}<section class="shrecknet-scene-links"><h3>Previous scene</h3><button type="button" class="shrecknet-page-scene-row" data-action="openScene" data-instance-id="{{resource.scene.instance_id}}" data-scene-id="{{resource.scene.previousScene.id}}">← {{resource.scene.previousScene.name}}</button></section>{{/if}}
        {{#if resource.scene.nextScene}}<section class="shrecknet-scene-links"><h3>Next scene</h3><button type="button" class="shrecknet-page-scene-row" data-action="openScene" data-instance-id="{{resource.scene.instance_id}}" data-scene-id="{{resource.scene.nextScene.id}}">{{resource.scene.nextScene.name}} →</button></section>{{/if}}
        {{#if resource.scene.relates_to.length}}<section class="shrecknet-shortcuts"><h3>Related records</h3><div class="shrecknet-card-grid shrecknet-related-grid">{{#each resource.scene.relates_to}}{{#if card}}<button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{card.instanceId}}">{{#if card.imageUrl}}<img src="{{card.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{label}} · {{card.name}}</span></button>{{else}}<span class="shrecknet-unavailable-related">{{label}} · related record unavailable</span>{{/if}}{{/each}}</div></section>{{/if}}
        {{#if resource.scene.milestones.length}}<section class="shrecknet-timeline"><h3>Milestone timeline</h3>{{#each resource.scene.milestones}}<article><span class="shrecknet-timeline-marker">●</span><h4>{{name}}</h4><div>{{description}}</div>{{#if relates_to.length}}<div class="shrecknet-card-grid shrecknet-related-grid">{{#each relates_to}}{{#if card}}<button type="button" class="shrecknet-page-card shrecknet-page-card-small" data-action="openInstance" data-instance-id="{{card.instanceId}}">{{#if card.imageUrl}}<img src="{{card.imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{label}} · {{card.name}}</span></button>{{else}}<span class="shrecknet-unavailable-related">{{label}} · related record unavailable</span>{{/if}}{{/each}}</div>{{/if}}</article>{{/each}}</section>{{/if}}
        <section class="shrecknet-perspectives"><h3>Character perspectives</h3><p>0 available</p></section>
      </article>
    {{else if (eq resource.kind "search")}}
      <h2>{{resource.title}}</h2>
      <section class="shrecknet-search-section"><h3>Pages</h3>{{#if resource.instances.length}}<div class="shrecknet-card-grid">{{#each resource.instances}}<button type="button" class="shrecknet-page-card" data-action="openInstance" data-instance-id="{{instance_id}}">{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{else}}<span class="shrecknet-card-placeholder">📄</span>{{/if}}<span>{{displayName}}</span></button>{{/each}}</div>{{else}}<p class="shrecknet-empty">NO PAGE RESULTS</p>{{/if}}</section>
      <section class="shrecknet-search-section"><h3>Narrative Scenes</h3>{{#if resource.sceneGroups.length}}{{#each resource.sceneGroups}}<details class="shrecknet-scene-group"><summary>{{#if imageUrl}}<img src="{{imageUrl}}" alt="">{{/if}}<span>📖 {{name}}</span><small>{{scenes.length}} scene hits</small></summary><div class="shrecknet-scene-group-content"><button type="button" class="shrecknet-source-page" data-action="openInstance" data-instance-id="{{instanceId}}">Open source page</button><div class="shrecknet-scene-rows">{{#each scenes}}<button type="button" class="shrecknet-scene-row" data-action="openScene" data-instance-id="{{instance_id}}" data-scene-id="{{id}}"><strong>▣ {{name}}</strong><small>◉ {{milestone_count}} milestones · 👁 {{perspective_count}} perspectives</small></button>{{/each}}</div></div></details>{{/each}}{{else}}<p class="shrecknet-empty">NO NARRATIVE SCENE RESULTS</p>{{/if}}</section>
    {{/if}}
  {{/unless}}
</div>
